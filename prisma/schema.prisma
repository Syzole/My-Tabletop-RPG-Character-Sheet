generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Item {
  name       String   @id
  source     String?
  page       Int?
  rarity     String
  type       String[]
  weight     Float
  value      Int
  properties Json?

  @@map("Items")
}

model Class {
  name                  String          @id
  hd_faces              Int
  savingThrowProfs      String[]
  startingProficiencies Json
  startingEquipment     Json
  multiclassing         Json
  class_features        Class_Feature[]
  subclasses            Subclass[]

  @@map("Classes")
}

model Class_Feature {
  class_name  String
  level       Int
  type        featureType
  description String
  properties  Json?
  name        String
  class       Class       @relation(fields: [class_name], references: [name])

  @@id([name, class_name, level])
  @@map("Class Features")
}

model Subclass {
  description       String?
  class_name        String
  properties        Json?
  subclass_name     String             @id @unique
  subclass_features Subclass_Feature[]
  classes           Class              @relation(fields: [class_name], references: [name], onDelete: Cascade)

  @@map("Subclasses")
}

model Subclass_Feature {
  subclass_name String
  level         Int
  description   String
  properties    Json?
  action_type   featureType
  feature_name  String      @id
  subclass      Subclass    @relation(fields: [subclass_name], references: [subclass_name], onDelete: Cascade)

  @@map("Subclass Features")
}

enum featureType {
  Attack
  Action
  BonusAction
  Reaction
  Other
  LimitedUse
  Passive

  @@map("Feature Type")
}

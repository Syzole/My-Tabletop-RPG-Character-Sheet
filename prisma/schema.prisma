generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Item {
  name       String   @id
  value      Int?
  weight     Float?
  source     String[]
  rarity     String
  type       String
  properties Json?

  @@unique([name, properties], name: "unique_name_properties")
  @@index([name], name: "idx_item_name")
  @@index([type], name: "idx_item_type")
  @@map("Items")
}

model Class {
  name                       String          @id
  startingProficiencies      Json
  startingEquipment          Json
  multiclassing              Json
  cantripProgression         Int[]
  casterProgression          String?
  classFeatures              String[]
  classTableGroups           Json?
  hd                         Int
  optionalfeatureProgression Json?
  page                       Int
  proficiency                String[]
  source                     String
  spellcastingAbility        String?
  spellsKnownProgression     Int[]
  subclassTitle              String
  Class_Feature              Class_Feature[]
  Subclass                   Subclass[]

  @@map("Classes")
}

model Class_Feature {
  source_name  String
  level        Int
  type         featureType
  description  String
  properties   Json?
  feature_name String
  class        Class       @relation(fields: [source_name], references: [name])

  @@id([feature_name, source_name, level])
  @@map("Class Features")
}

model Subclass {
  description       String?
  class_name        String
  properties        Json?
  subclass_name     String             @id
  subclass_features Subclass_Feature[]
  classes           Class              @relation(fields: [class_name], references: [name], onDelete: Cascade)

  @@map("Subclasses")
}

model Subclass_Feature {
  source_name  String
  level        Int
  description  String
  properties   Json?
  type         featureType
  feature_name String      @id
  subclass     Subclass    @relation(fields: [source_name], references: [subclass_name], onDelete: Cascade)

  @@map("Subclass Features")
}

enum featureType {
  Attack
  Action
  BonusAction
  Reaction
  Other
  LimitedUse
  Passive

  @@map("Feature Type")
}

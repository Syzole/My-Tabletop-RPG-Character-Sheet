generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Item {
  name       String   @id
  value      Int?
  weight     Float?
  source     String[]
  rarity     String
  type       String
  properties Json?

  @@unique([name, properties], name: "unique_name_properties")
  @@index([name], name: "idx_item_name")
  @@index([type], name: "idx_item_type")
  @@map("Items")
}

model Class {
  name                       String
  version                    String
  source                     String[]
  hitDice                    Int
  savingThrowProf            String[]
  skillsProf                 Json
  startingProficiencies      Json
  startingEquipmentOptions   Json
  multiclassing              Json?
  optionalfeatureProgression Json?
  Spellcasting               Json?
  Class_Feature              Class_Feature[]
  Subclass                   Subclass[]

  @@id([name, version])
  @@map("Classes")
}

model Class_Feature {
  feature_name String
  source_name  String
  version      String
  level        Int
  type         featureType
  description  String
  properties   Json?
  class        Class       @relation(fields: [source_name, version], references: [name, version])

  @@id([feature_name, source_name, level])
  @@map("Class Features")
}

model Subclass {
  subclass_name     String             @id
  description       String?
  class_name        String
  version           String
  properties        Json?
  subclass_features Subclass_Feature[]
  classes           Class              @relation(fields: [class_name, version], references: [name, version], onDelete: Cascade)

  @@map("Subclasses")
}

model Subclass_Feature {
  source_name  String
  level        Int
  description  String
  properties   Json?
  type         featureType
  feature_name String      @id
  subclass     Subclass    @relation(fields: [source_name], references: [subclass_name], onDelete: Cascade)

  @@map("Subclass Features")
}

enum featureType {
  Attack
  Action
  BonusAction
  Reaction
  Other
  LimitedUse
  Passive

  @@map("Feature Type")
}
